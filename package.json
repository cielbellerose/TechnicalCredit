{
  "name": "technicalcredit",
  "displayName": "TechnicalCredit",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "technicalcredit.analyseForTC",
        "title": "Analyse for TC"
      },
      {
        "command": "technicalcredit.acceptTCComment",
        "title": "Technical Credit: Accept"
      },
      {
        "command": "technicalcredit.dismissTCComment",
        "title": "Technical Credit: Dismiss"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "technicalcredit.analyseForTC",
          "group": "navigation",
          "when": "editorTextFocus"
        }
      ],
      "commandPalette": [
        {
          "command": "technicalcredit.acceptTCComment",
          "when": "false"
        },
        {
          "command": "technicalcredit.dismissTCComment",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run tsc:check && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run tsc:check && npm run lint && node esbuild.js --production",
    "test": "jest",
    "lint:check": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "tsc:check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "opro": "esbuild scripts/opro.ts --bundle --platform=node --external:@anthropic-ai/sdk --external:dotenv --outfile=dist/opro.js && node dist/opro.js"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "dotenv/config"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "esModuleInterop": true,
            "isolatedModules": true
          }
        }
      ]
    }
  },
  "devDependencies": {
    "@types/dotenv": "^8.2.3",
    "@types/emscripten": "^1.41.5",
    "@types/jest": "^30.0.0",
    "@types/node": "26.x",
    "@types/vscode": "^1.120.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "jest": "^30.4.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "anthropic-ai": "^0.0.10",
    "dotenv": "^17.4.2",
    "tree-sitter-java": "^0.23.5",
    "web-tree-sitter": "^0.26.11"
  }
}
