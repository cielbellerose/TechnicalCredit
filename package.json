{
  "name": "technicalcredit",
  "displayName": "TechnicalCredit",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "myExtension.askClaude",
        "title": "Ask Claude: What's up?"
      },
      {
        "command": "technicalcredit.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "technicalcredit.analyseForTC",
        "title": "Analyse for TC"
      },
      {
        "command": "technicalcredit.acceptTCComment",
        "title": "Technical Credit: Accept"
      },
      {
        "command": "technicalcredit.dismissTCComment",
        "title": "Technical Credit: Dismiss"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "technicalcredit.analyseForTC",
          "group": "navigation",
          "when": "editorTextFocus"
        }
      ],
      "commandPalette": [
        {
          "command": "technicalcredit.acceptTCComment",
          "when": "false"
        },
        {
          "command": "technicalcredit.dismissTCComment",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run tsc:check && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run tsc:check && npm run lint && node esbuild.js --production",
    "test": "jest",
    "lint:check": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "tsc:check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ]
  },
  "devDependencies": {
    "@types/dotenv": "^8.2.3",
    "@types/emscripten": "^1.41.5",
    "@types/jest": "^30.0.0",
    "@types/node": "25.x",
    "@types/vscode": "^1.120.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.3",
    "jest": "^30.4.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "anthropic-ai": "^0.0.10",
    "dotenv": "^17.4.2",
    "tree-sitter-java": "^0.23.5",
    "web-tree-sitter": "^0.26.9"
  }
}
